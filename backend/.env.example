# Backend Environment Variables for Local Development

ENFORCER_MODEL=./core/services/policies/casbin/model.conf
ENFORCER_POLICY=./core/services/policies/casbin/policy.csv
INSTANCE_CONFIGS=./data/configs
AMS_RELOAD=true
# postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+asyncpg://objtree_app:1q2w3e4r@postgres:5432/inn_objtree
# Base64 encoded 32 byte key.
SECRET_ENCRYPTION_KEY=JzATRY8v4ztexRVDLlqpaOBm8AfGvwwtC2NU47diyE0=

# Keycloak
KEYCLOAK_DOMAIN=http://localhost:8080
KEYCLOAK_REALM=ams-portal
KEYCLOAK_UI_CLIENT_ID=ams-portal-ui
KEYCLOAK_ADMIN_CLIENT_ID=ams-portal-admin
# Available in local/keycloak/keycloak-realm-export.json if running in docker
# Otherwise must manually be set
KEYCLOAK_ADMIN_CLIENT_SECRET=5p8ET0VMIG3pLRZ18MZXJBPkjqIL1hAq
KEYCLOAK_TOKEN_ISSUER=http://localhost:8080/realms/ams-portal
KEYCLOAK_EXTERNAL_ISSUER=http://localhost:8080/realms/ams-portal

# Mongo
# Use one MongoDB configuration method:
# MONGO_URI=mongodb://...
# OR:
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INIT_ROOT_USERNAME=admin
MONGO_INIT_ROOT_PASSWORD=admin123
MONGO_DB=inn_mongo
MONGO_INSTANCE_COLLECTION=connection-storage-instances
MONGO_PROJECT_INSTANCE_ASSOCIATION_COLLECTION=project-instance-associations

# Bundler
BUNDLER_PROVIDER=java
# Change if running locally
JAVA_BUNDLER_URL=http://java-bundler:8888
# Required instead when BUNDLER_PROVIDER=python:
PYTHON_BUNDLER_URL=http://bundler:8082
BUNDLE_SOURCE_URL_EXPIRATION_SECONDS=7200

# Security-required if the webhook is externally reachable
OBJECT_STORAGE_WEBHOOK_SECRET=<high-entropy-secret>
