# .env.sample
# Locally build, deploy and run
# Create a copy of .env.sample and call it .env. Update the variables accordingly.
# Activate the variables withing using the commands:
# $ source ../../.gitlab/helper_utils.sh
# $ source .env

####################
# BUILD AND DEPLOY #
####################

## CI/CD: Docker compose build details
export REGISTRY_IMAGE="YOUR REGISTRY NAME/ORG/PROJECT HERE"

# export CREATED_DATE="$(gdate --rfc-3339=seconds)" # AUTO POPULATED using GNU `date` command
## I don't know why the above command alone doesn't work
## unless I `export` and `source .env`

# Get the current commit datetime (without timezone)
# AUTO POPULATED using the checked out git repo and ../../.gitlab/scripts/helper_utils.sh

# based on purpose: latest | test
# export TYPE_OF_BUILD=manual

# based on deployment environment: prod | staging | dev
# export STAGE_TAG=manual
# export TAG_DATE="$(gdate +'%Y%m%d-%H%M')"

# export VCS_REPO_URL="$(get_repo_link)"
# export VCS_REF="$(git rev-parse HEAD)"
# export VCS_REF_NAME="$(git rev-parse --abbrev-ref HEAD)"
# export VCS_SOURCE="$(get_source_link)"

# | `COMMIT_SHORT` | Short commit SHA | `a1b2c3d` |
# export COMMIT_SHORT="$(git rev-parse --short HEAD)"

# | `COMMIT_SHORT_DATE` | Timestamp for deploy | `YYYYMMDD-HHMM` |
export COMMIT_SHORT_DATE="$(git show -s --date=format:'%Y%m%d-%H%M' --format=%cd HEAD | xargs)"

# | `IMAGE_TAG` | Branch or tag name | `main`, `v1.0` |
# export IMAGE_TAG="${VCS_REF_NAME}"

