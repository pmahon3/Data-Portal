# An example using multi-stage image builds to create a final image without uv.

# First, build the application in the `/app` directory.
# uv multi-stage image: builder → test_runner → service (parity with generated Dockerfile).
# Extends the pattern in multistage.Dockerfile with a test stage and a production CMD.
#
# Build from the `bundler` directory (sibling of `bundler_app` and `bundler_app_server_gen`)
# so path dependencies in pyproject.toml resolve:
#   docker build -f bundler_app_server_gen/Dockerfile.uv -t openapi-server:uv .
#
# Targets: builder | test_runner | service (default)

ARG PYTHON_VERSION=3.10
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Omit development dependencies
ENV UV_NO_DEV=1

# Disable Python downloads, because we want to use the system interpreter
# across both images. If using a managed Python version, it needs to be
# copied from the build image into the final image; see `standalone.Dockerfile`
# for an example.
ENV UV_PYTHON_DOWNLOADS=0

# Some locked deps (e.g. ujson) compile C/C++ extensions when no matching wheel
# exists for the build platform (often linux-aarch64). Slim images omit g++.
# uv only builds a package when there is no compatible wheel for the current platform
# documented fix is: install the missing tool with the OS package manager
# See:https://docs.astral.sh/uv/reference/troubleshooting/build-failures/
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
WORKDIR /app/bundler_app
COPY --from=bundler_app ./pyproject.toml ./uv.lock ./
WORKDIR /app/server_api
COPY --from=server_api ./pyproject.toml ./uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project

COPY --from=bundler_app . /app/bundler_app
COPY --from=server_api . /app/server_api
WORKDIR /app/server_api
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked
RUN --mount=type=cache,target=/root/.cache/uv \
    uv add ../bundler_app



# It is important to use the image that matches the builder, as the path to the
# Python executable must be the same, e.g., using `python:3.11-slim-bookworm`
# will fail.
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS test_runner
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# test dependencies are needed
ENV UV_NO_DEV=0

ENV UV_PYTHON_DOWNLOADS=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy the application from the builder
COPY --from=builder --chown=nonroot:nonroot /app /app

WORKDIR /app/server_api
RUN uv run --with pytest pytest tests



# Then, use a final image without uv
FROM python:${PYTHON_VERSION}-slim-bookworm AS service
# It is important to use the image that matches the builder, as the path to the
# Python executable must be the same, e.g., using `python:3.11-slim-bookworm`
# will fail.

# Setup a non-root user
RUN groupadd --system --gid 999 nonroot \
 && useradd --system --gid 999 --uid 999 --create-home nonroot

COPY --from=test_runner --chown=nonroot:nonroot /app /app

# Place executables in the environment at the front of the path
ENV PATH="/app/server_api/.venv/bin:$PATH"

# Use the non-root user to run our application
USER nonroot
USER root

WORKDIR /app/server_api

# Run the FastAPI application by default
CMD ["uvicorn", "openapi_server.main:app", "--host", "0.0.0.0", "--port", "8080"]

