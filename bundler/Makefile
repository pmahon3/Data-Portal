
# Core targets for OpenAPI generation, uv wiring, sync, test, clean.
# Variables: make/vars.mk — docs README_reference.md (openapitools.json, Makefile requirements).

include $(dir $(lastword $(MAKEFILE_LIST)))make/vars.mk

# build: generate-openapi + dependency wiring; all: build → sync → test (see target prerequisites).
.PHONY: check-tools generate-openapi clean build add-deps add-dev-deps sync test all

check-tools:
	@echo "Required tools: $(REQUIRED_TOOLS) ..."
	@for t in $(REQUIRED_TOOLS); do \
		command -v "$$t" >/dev/null 2>&1 || { \
			echo "Missing required tool: $$t (need: $(REQUIRED_TOOLS))"; \
			exit 1; \
		}; \
	done
	@echo "All required tools are installed."
	@echo

generate-openapi: check-tools
	@echo "OpenAPI: generate server stub (key=$(OPENAPI_GENERATOR_KEY)) ..."
ifeq ($(SKIP_GENERATE),1)
	@echo "SKIP_GENERATE=1: not running generator; would run: $(OPENAPI_NPX) generate --generator-key $(OPENAPI_GENERATOR_KEY)"
else
	$(OPENAPI_NPX) version
	@echo
	$(OPENAPI_NPX) generate --generator-key "$(OPENAPI_GENERATOR_KEY)"
endif
	@echo

build: generate-openapi add-deps add-dev-deps

add-deps:
	@echo "Adding core logic runtime dependency to app ..."
	uv add --directory "$(OPENAPI_OUTPUT_FOLDER)" "$(CORE_SOURCE_PATH)" --no-sync # Path-only: uv reads [project].name from the dependency tree; --no-sync: update metadata/lock, skip install until `uv sync`;
	@echo "Adding runtime dependencies from requirements.txt ..."
	uv add --directory "$(OPENAPI_OUTPUT_FOLDER)" --no-sync -r requirements.txt
	@echo "Adding hand-owned observability dependencies from requirements-observability.txt ..."
	uv add --directory "$(OPENAPI_OUTPUT_FOLDER)" --no-sync -r requirements-observability.txt
	@echo

add-dev-deps:
	@echo "Adding dev dependencies from requirements-dev.txt ..."
	cp "$(APP_CORE_DIR)/requirements-dev.txt" "$(OPENAPI_OUTPUT_FOLDER)/requirements-dev.txt" # FIXME: temporary workaround since the file is not generated by the openapi-generator-cli
	uv add --directory "$(OPENAPI_OUTPUT_FOLDER)" --dev --no-sync -r requirements-dev.txt
	@echo

sync: add-deps add-dev-deps
	@echo "Syncing environment and local dev package, adding external dependency $(CORE_SOURCE_PATH) as a dev dependency ..."
	uv sync --directory "$(OPENAPI_OUTPUT_FOLDER)"
	@echo

test: 
	@echo "Running pytest test suite (server tree @ OPENAPI_IMPL_COV_PATH=$(OPENAPI_IMPL_COV_PATH), then core @ $(APP_CORE_DIR)) …"
	uv run --directory "$(OPENAPI_OUTPUT_FOLDER)" --with pytest --with pytest-cov python -m pytest tests --cov="$(OPENAPI_IMPL_COV_PATH)"
	uv run --directory "$(APP_CORE_DIR)" --with pytest --with pytest-cov python -m pytest tests
	@echo

# Must include ``build`` so codegen + ``uv add`` wiring run before ``sync``/``test`` (matches README_dev).
all: build sync test
	@printf '%*s\n' "$$(tput cols)" '' | tr ' ' '=' # Dynamically determines the width of the current terminal in columns to fill with =
	@echo
	@echo "Completed build, sync, and tests ..."
	@echo "Reminder: run \`$$ make -f Makefile -f make/bootstrap.mk export-pinned\` to (re)generate requirements-pinned.txt using pinned versions from requirements.txt."
	@echo

clean:
	@echo "clean - removes each path listed in $(OPENAPI_OUTPUT_FOLDER)/.openapi-generator/FILES, then runs git restore on $(OPENAPI_OUTPUT_FOLDER)."
	@echo
	@if test -z "$(OPENAPI_OUTPUT_FOLDER)" || test "$(OPENAPI_OUTPUT_FOLDER)" = "/" || test "$(OPENAPI_OUTPUT_FOLDER)" = "."; then \
		echo "clean skipped: OPENAPI_OUTPUT_FOLDER ('$(OPENAPI_OUTPUT_FOLDER)') cannot be empty, /, or . (too risky for rm + git restore here)."; \
		echo "Use a dedicated output directory in openapitools.json, or delete or git restore paths listed in .openapi-generator/FILES yourself."; \
		exit 1; \
	fi
	@if test ! -d "$(OPENAPI_OUTPUT_FOLDER)"; then \
		echo "Nothing to clean: no directory at OPENAPI_OUTPUT_FOLDER='$(OPENAPI_OUTPUT_FOLDER)'"; \
		exit 0; \
	fi

	@# strips carriage returns (\r), drops comments/blank lines, prefix with parent directory path, then deletes listed paths via xargs
	@files_manifest="$(OPENAPI_OUTPUT_FOLDER)/.openapi-generator/FILES"; \
	if test -f "$$files_manifest"; then \
		sed -e 's/\r$$//' -e '/^[[:space:]]*$$/d' -e '/^[[:space:]]*#/d' "$$files_manifest" \
		| sed -e "s|^|$(OPENAPI_OUTPUT_FOLDER)/|" \
		| xargs -I{} sh -c 'echo "removing $$1 ..." && rm -rf "$$1"' _ {}; \
	fi

	git restore "$(OPENAPI_OUTPUT_FOLDER)" # restore the original server stub
	@echo
