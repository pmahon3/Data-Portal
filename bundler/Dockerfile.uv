# An example using multi-stage image builds to create a final image without uv.

# First, build the application in the `/app` directory.
# uv multi-stage image: builder → test_runner → service (parity with generated Dockerfile).
# Extends the pattern in multistage.Dockerfile with a test stage and a production CMD.
#
# Build from the `bundler/` directory (OpenAPI output root; contains `bundler_server/`,
# `bundler_core/`, `pyproject.toml`, `uv.lock`):
#   docker build -f Dockerfile.uv --target service -t bundler-service:local .
#
# Targets: builder | test_runner | service (default)

ARG PYTHON_VERSION=3.10
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Omit development dependencies
ENV UV_NO_DEV=1

# Disable Python downloads, because we want to use the system interpreter
# across both images. If using a managed Python version, it needs to be
# copied from the build image into the final image; see `standalone.Dockerfile`
# for an example.
ENV UV_PYTHON_DOWNLOADS=0

# Some locked deps (e.g. ujson) compile C extensions when no wheel exists for the build platform.
# Slim images omit g++.
# uv only builds a package when there is no compatible wheel for the current platform
# documented fix is: install the missing tool with the OS package manager
# See: https://docs.astral.sh/uv/reference/troubleshooting/build-failures/
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
WORKDIR /app/bundler

# Workspace member sources (not lockfiles) required before the first sync.
COPY bundler_core/__init__.py ./bundler_core/
COPY bundler_core/src ./bundler_core/src/

# Deps-only + bundler-core (not server package) layer: bind lockfiles from the build context 
# (not COPY) so this step rebuilds only when pyproject.toml / uv.lock change, not when app code changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=bundler_core/pyproject.toml,target=bundler_core/pyproject.toml \
    --mount=type=bind,source=bundler_core/uv.lock,target=bundler_core/uv.lock \
    uv sync --locked --no-install-project --no-dev

COPY . .

# server package layer: after including server package, sync with the server package
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev


# It is important to use the image that matches the builder, as the path to the
# Python executable must be the same, e.g., using `python:3.11-slim-bookworm`
# will fail.
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS test_runner
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# test dependencies are needed
ENV UV_NO_DEV=0

ENV UV_PYTHON_DOWNLOADS=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy the application from the builder
COPY --from=builder --chown=nonroot:nonroot /app /app

WORKDIR /app/bundler

# Dev group (pytest, etc.) for server HTTP tests; pytest.toml ignores generated stub tests.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --group dev \
    && uv run python -m pytest tests \
    && touch /tmp/tests-ok


# Then, use a final image without uv
FROM python:${PYTHON_VERSION}-slim-bookworm AS service
# It is important to use the image that matches the builder, as the path to the
# Python executable must be the same, e.g., using `python:3.11-slim-bookworm`
# will fail.

# Setup a non-root user
RUN groupadd --system --gid 999 nonroot \
 && useradd --system --gid 999 --uid 999 --create-home nonroot

# Force test_runner to complete before packaging (BuildKit stage dependency).
COPY --from=test_runner /tmp/tests-ok /tmp/tests-ok

# Production tree from builder only.
COPY --from=builder --chown=nonroot:nonroot /app /app

# Use the non-root user to run our application
USER nonroot
WORKDIR /app/bundler

# Run the FastAPI application by default
ENV PATH="/app/bundler/.venv/bin:$PATH"
CMD ["uvicorn", "bundler_server.main:app", "--host", "0.0.0.0", "--port", "8080"]

