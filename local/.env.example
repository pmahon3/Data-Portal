# Enviroment Variables for Running in Docker
# If running a service locally you must set the .env variables there
# i.e. backend/.env if running backend locally

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
# Client secret must match ams-portal-admin client
# Also available in realm export
KEYCLOAK_ADMIN_CLIENT_SECRET=5p8ET0VMIG3pLRZ18MZXJBPkjqIL1hAq

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

# PostgreSQL
POSTGRES_USER=objtree_app
POSTGRES_PASSWORD=1q2w3e4r
POSTGRES_DB=inn_objtree

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=1q2w3e4r

# Mongo Express
ME_CONFIG_BASICAUTH_PASSWORD=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin123

# Stable Fernet encryption key. Must match to decrypt stored instance credentials
# Base64 encoded 32 byte key.
SECRET_ENCRYPTION_KEY=JzATRY8v4ztexRVDLlqpaOBm8AfGvwwtC2NU47diyE0=

# Java bundler output storage
BUNDLER_OUTPUT_OBJECT_STORAGE_ENDPOINT=http://minio:9000
BUNDLER_OUTPUT_OBJECT_STORAGE_REGION=us-east-1
BUNDLER_OUTPUT_OBJECT_STORAGE_BUCKET=bundles
BUNDLER_OUTPUT_OBJECT_STORAGE_KEY_PREFIX=bundles
BUNDLER_OUTPUT_OBJECT_STORAGE_ACCESS_KEY_ID=admin
BUNDLER_OUTPUT_OBJECT_STORAGE_SECRET_ACCESS_KEY=admin123
BUNDLER_OUTPUT_OBJECT_STORAGE_PATH_STYLE_ACCESS=true
BUNDLER_OUTPUT_OBJECT_STORAGE_PRESIGNED_URL_EXPIRATION_SECONDS=3600