server {
  listen 80 default_server;
  server_name "";

  # React SPA: serve files or fall back to index.html
  root /usr/share/nginx/html;
  index index.html;

  # Health check endpoints
  location /health {
    access_log off;
    return 200 "healthy\n";
    add_header Content-Type text/plain;
  }

  location /ready {
    access_log off;
    return 200 "ready\n";
    add_header Content-Type text/plain;
  }

  location / {
    try_files $uri /index.html;
  }

  # Proxy API calls to backend in Nomad
  location /api/ {
    proxy_http_version 1.1;

    # original host and client chain from Traefik
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # Pass through the original client scheme (Traefik sets this)
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    
    proxy_pass ${API_GATEWAY};
    proxy_redirect off;
  }
}

